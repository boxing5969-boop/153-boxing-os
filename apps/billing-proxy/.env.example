# ============================================================
# billing-proxy 환경 변수 — Google Cloud Run / 로컬 dev
# ============================================================
# 실제 시크릿은 Google Secret Manager 에 저장하고 Cloud Run service 에 mount.
# 로컬 개발 시에만 .env 파일 사용 (gitignored).
# 절대 GIT 에 커밋 금지.
# ============================================================

# --- 기본 ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # service_role JWT — DB 모든 권한, 프런트 노출 절대 금지
SUPABASE_JWT_SECRET=                    # (선택) HS256 로컬 토큰 검증용. 없으면 JWKS 모드.

# --- Aligo (SMS/LMS/MMS) ---
ALIGO_USER_ID=
ALIGO_API_KEY=
ALIGO_SENDER_DEFAULT=                   # (선택) sender 미지정 시 기본 발신번호

# --- Payssam / 결제선생 ---
PAYSSAM_API_KEY=
PAYSSAM_API_BASE_URL=https://api.payssam.example.com   # TODO: 실 docs 받은 후 교체
PAYSSAM_WEBHOOK_SECRET=                 # (선택) webhook 서명 검증용

# --- 내부 인증 (Cloud Tasks / Workers→Cloud Run) ---
INTERNAL_TASK_SECRET=                   # /tasks/* 호출 시 X-Internal-Secret 헤더 검증값
                                        # 운영에서는 OIDC + Google service account 권장

# --- Cloud Tasks (운영 큐 — 미설정 시 LocalImmediateQueue 자동 fallback) ---
CLOUD_TASKS_PROJECT_ID=                 # GCP project ID
CLOUD_TASKS_LOCATION=asia-northeast3    # 큐 리전
CLOUD_TASKS_QUEUE_MESSAGES=billing-msg  # 메시지 발송 큐 이름
CLOUD_TASKS_QUEUE_INVOICES=billing-inv  # 청구서 발송 큐 이름
CLOUD_RUN_BASE_URL=                     # 본 서비스 base URL (예: https://billing-proxy-xxx.run.app)
OIDC_INVOKER_SERVICE_ACCOUNT=           # OIDC 토큰 발급용 SA 이메일 (예: billing-tasks@PROJECT.iam.gserviceaccount.com)

# --- 기능 토글 ---
PROVIDER_MODE=mock                      # 'mock' | 'live' — mock 모드는 외부 API 호출 안하고 예측 가능한 응답
MOCK_PROVIDERS=                         # (deprecated) PROVIDER_MODE 사용. true → mock
CLOUD_TASKS_QUEUE=                      # (deprecated, 위 CLOUD_TASKS_QUEUE_* 사용)

# --- 일반 ---
WEBHOOK_SECRET=                         # 범용 webhook HMAC 검증 시
