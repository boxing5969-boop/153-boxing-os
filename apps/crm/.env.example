# apps/crm 전용 환경변수 (Vite 가 이 파일 옆의 .env 를 자동 로드)
# Supabase Dashboard → Settings → API 에서 복사
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:8787

# 선택 — Sentry DSN (CRM 전용. Workers 는 별도 SENTRY_DSN)
VITE_SENTRY_DSN=

# ───────────────────────────────────────────────────────────────
# 배포 환경 — Cloudflare Pages 환경변수 등록 (Production + Preview 모두 필수)
# 대시보드: dash.cloudflare.com → Pages → 153-boxing-os → 설정 → 변수 및 비밀
# 위 모든 VITE_* 변수는 빌드 시점에 inline 되므로, 환경변수 추가/변경 후 반드시 재배포 필요.
# Preview 환경에 변수가 없으면 main 외 브랜치 빌드는 fallback (localhost) 으로 빌드되어
# 브라우저에서 "Failed to fetch" 발생.
