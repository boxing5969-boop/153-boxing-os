# apps/crm 전용 환경변수 (Vite 가 이 파일 옆의 .env 를 자동 로드)
# Supabase Dashboard → Settings → API 에서 복사
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:8787

# Cloud Run billing-proxy (Phase 20B/C — 운영 크레딧 / 외부 결제·문자 발송 엔드포인트)
# 로컬: http://localhost:8080  /  운영: https://billing-proxy-<hash>.run.app
VITE_BILLING_PROXY_URL=http://localhost:8080

# 선택 — Sentry DSN (CRM 전용. Workers 는 별도 SENTRY_DSN)
VITE_SENTRY_DSN=
