# workers/api/.dev.vars (실제 파일은 gitignore — 절대 커밋 금지)
# wrangler dev 가 자동 로드함

ENVIRONMENT=development
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-dashboard
QR_SIGNING_SECRET=your-random-32-byte-secret
DEVICE_API_KEY=your-shared-device-hmac-key
DEVICE_KMS_KEY=your-32-byte-master-key

# 선택 — Sentry DSN 설정 시 에러 자동 추적
SENTRY_DSN=
