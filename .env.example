# Supabase (Phase 3 에서 발급)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Workers 시크릿 (Phase 4) — workers/api/.dev.vars 또는 wrangler secret put 으로 등록
QR_SIGNING_SECRET=
DEVICE_API_KEY=
DEVICE_KMS_KEY=

# Sentry (Phase 12, 선택)
SENTRY_DSN=                   # Workers 용 (sentry.io 프로젝트의 cloudflare-worker DSN)
VITE_SENTRY_DSN=              # CRM 용 (sentry.io 프로젝트의 react DSN, 별도 권장)

# CRM 환경 (Vite 는 VITE_ 접두사 필수) — apps/crm/.env 에 저장
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8787
# Cloud Run billing-proxy (Phase 20B/C — 운영 크레딧·문자·청구서 발송 엔드포인트)
VITE_BILLING_PROXY_URL=http://localhost:8080
